bodega.planta {
    tls /etc/caddy/certs/bodega.planta.pem /etc/caddy/certs/bodega.planta-key.pem
    request_body { max_size 10MB }

    @api path /api/* /health
    handle @api {
        reverse_proxy api:8000
    }
    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(self), microphone=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
}
